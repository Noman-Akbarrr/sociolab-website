# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# prisma generated client
# /src/generated  -- committed so deploy doesn't need prisma generate

# local puck content store (auth + pages in dev)
/.puck

# admin-uploaded images (serve from a persistent volume in production)
/public/uploads

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
